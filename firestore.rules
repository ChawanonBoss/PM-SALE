// PM-SALE — Firestore rules (reference copy; must be pasted into Firebase Console → Firestore → Rules by hand).
//
// PM-SALE shares the Firebase project "bu-abb" with BU-ABB but uses its own pm_-prefixed collections.
// Firestore rules are ONE file per project, so this file is NOT pasteable on its own (it has no service/match wrapper):
// insert the block between the two "PM-SALE" markers INSIDE the existing `match /databases/{database}/documents { ... }`
// (before its closing brace) next to the BU-ABB rules, then Publish. Placed after that closing brace, the Console fails
// with "Unexpected 'match'". The same block is already merged into the live rules in the Console.
//
// First admin (one-time): rules cannot prove "the users collection is empty", so before the very first PM-SALE
// sign-in, create a document  pm_config/bootstrap  in the Console (any field, e.g. open: true). The first person to
// sign in then becomes admin. DELETE pm_config/bootstrap right afterwards — while it exists, any new sign-up could
// self-create an admin profile.
//
// Client queries in index.html and these rules must change together: a non-admin's pm_projects / pm_customers
// listeners use .where('createdBy','==',uid) to match the createdBy conditions below.

    // ===== PM-SALE: begin =====
    function pmIsAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/pm_users/$(request.auth.uid))
        && get(/databases/$(database)/documents/pm_users/$(request.auth.uid)).data.role == 'admin';
    }

    // New sign-ups are created with status 'pending' (see the pm_users create rule) and are refused every business collection until an admin
    // sets 'approved'. A profile with no `status` field at all is an older, already-working account and counts as approved.
    function pmIsApproved() {
      return request.auth != null
        && exists(/databases/$(database)/documents/pm_users/$(request.auth.uid))
        && get(/databases/$(database)/documents/pm_users/$(request.auth.uid)).data.get('status', 'approved') == 'approved';
    }

    match /pm_projects/{id} {
      allow read: if pmIsAdmin() || (pmIsApproved() && resource.data.createdBy == request.auth.uid);
      allow create: if pmIsApproved() && request.resource.data.createdBy == request.auth.uid;
      allow update: if pmIsAdmin()
        || (pmIsApproved() && resource.data.createdBy == request.auth.uid
            && request.resource.data.createdBy == resource.data.createdBy);
      allow delete: if pmIsAdmin();   // the app only ever soft-deletes (an update); a real delete is the admin's Trash purge
    }

    match /pm_customers/{id} {
      allow read: if pmIsAdmin() || (pmIsApproved() && resource.data.createdBy == request.auth.uid);
      allow create: if pmIsApproved() && request.resource.data.createdBy == request.auth.uid;
      allow update: if pmIsAdmin()
        || (pmIsApproved() && resource.data.createdBy == request.auth.uid
            && request.resource.data.createdBy == resource.data.createdBy);
      allow delete: if pmIsAdmin();   // the app only ever soft-deletes (an update); a real delete is the admin's Trash purge
    }

    // Company profiles (letterhead): everyone signed in can read (needed to print), only admin edits.
    match /pm_companies/{id} {
      allow read: if pmIsApproved();
      allow create, update, delete: if pmIsAdmin();
    }

    // Warehouse stock is shared: any signed-in user can read, add and edit items; only admin can delete
    // (a soft-delete is an update that sets deletedAt, so that key is blocked for non-admins here).
    // Non-admins are limited to the fields the app itself writes (item details, quantity, serials, history), the quantity must stay a
    // non-negative number, createdBy / deletedAt / any other key cannot be touched, and the withdrawal history can only grow
    // (it is capped at 500 by the app, so it never shrinks legitimately).
    match /pm_warehouse/{id} {
      allow read: if pmIsApproved();
      allow create: if pmIsAdmin()
        || (pmIsApproved() && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.keys().hasOnly(['part','name','type','brand','quantity','serials','note','createdBy','createdAt'])
            && request.resource.data.quantity is number && request.resource.data.quantity >= 0);
      allow update: if pmIsAdmin()
        || (pmIsApproved()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['part','name','type','brand','quantity','serials','note','history'])
            && request.resource.data.quantity is number && request.resource.data.quantity >= 0
            && (!('history' in resource.data)
                || (request.resource.data.history is list && request.resource.data.history.size() >= resource.data.history.size())));
      allow delete: if pmIsAdmin();
    }

    // Service warehouse: same sharing model as pm_warehouse above (any approved user reads/adds/edits, admin-only delete, deletedAt blocked
    // for non-admins so a soft-delete stays admin-only) but for services rather than stocked goods - no quantity/serials/history to guard.
    match /pm_serviceWarehouse/{id} {
      allow read: if pmIsApproved();
      allow create: if pmIsAdmin()
        || (pmIsApproved() && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.keys().hasOnly(['part','name','type','brand','note','createdBy','createdAt']));
      allow update: if pmIsAdmin()
        || (pmIsApproved() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['part','name','type','brand','note']));
      allow delete: if pmIsAdmin();
    }

    // Project attachments (one document per file; the bytes are base64 inside `data`, under Firestore's 1 MB limit). `ownerId` is the project's
    // creator: that person and the admins may read, add and delete; nobody edits a file in place.
    match /pm_files/{id} {
      allow read: if pmIsAdmin() || (pmIsApproved() && resource.data.ownerId == request.auth.uid);
      allow create: if pmIsAdmin()
        || (pmIsApproved() && request.resource.data.ownerId == request.auth.uid && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.data is string && request.resource.data.data.size() < 900000);
      allow update: if false;
      allow delete: if pmIsAdmin() || (pmIsApproved() && resource.data.ownerId == request.auth.uid);
    }

    // Handover photos (equipment / installation sets): one document per photo, same base64-under-1MB shape and ownerId scoping as pm_files above.
    match /pm_photos/{id} {
      allow read: if pmIsAdmin() || (pmIsApproved() && resource.data.ownerId == request.auth.uid);
      allow create: if pmIsAdmin()
        || (pmIsApproved() && request.resource.data.ownerId == request.auth.uid && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.data is string && request.resource.data.data.size() < 900000);
      allow update: if false;
      allow delete: if pmIsAdmin() || (pmIsApproved() && resource.data.ownerId == request.auth.uid);
    }

    // Document-number counters (SO20260921 -> n): any signed-in user may create one or raise it, never lower it. The app falls back to
    // "highest visible number + 1" if these rules aren't published, so publishing them is what makes numbering race-proof.
    match /pm_counters/{id} {
      allow read: if pmIsApproved();
      allow create: if pmIsApproved() && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n is int && request.resource.data.n >= 1;
      allow update: if pmIsApproved() && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n is int && request.resource.data.n > resource.data.n;
      allow delete: if pmIsAdmin();
    }

    // Product catalogs (PDF stored as pieces): everyone signed in can read and download, only admin uploads / edits / deletes.
    match /pm_catalogs/{id} {
      allow read: if pmIsApproved();
      allow create, update, delete: if pmIsAdmin();
    }
    match /pm_catalogChunks/{id} {
      allow read: if pmIsApproved();
      allow create, update, delete: if pmIsAdmin();
    }

    // pm_users: your own profile is always readable (a waiting account has to see its own status); everything else needs an approved account.
    // A brand-new sign-up may only create a 'pending' profile of role 'user'; being pre-invited by an admin (pm_pendingRoles) gives the invited role
    // already approved; the first-ever admin needs the pm_config/bootstrap marker (made by hand in the Console). Nobody can change their own role or status.
    match /pm_users/{userId} {
      allow get: if request.auth != null && (request.auth.uid == userId || pmIsApproved());
      allow list: if pmIsApproved()
        || (request.auth != null && exists(/databases/$(database)/documents/pm_config/bootstrap) && request.query.limit <= 1);
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['email','name','role','status'])
        && (
          (request.resource.data.role == 'user' && request.resource.data.status == 'pending')
          || (
            exists(/databases/$(database)/documents/pm_pendingRoles/$(request.auth.token.email.lower()))
            && get(/databases/$(database)/documents/pm_pendingRoles/$(request.auth.token.email.lower())).data.role == request.resource.data.role
            && request.resource.data.get('status', 'approved') == 'approved'
          )
          || (
            request.resource.data.role == 'admin'
            && request.resource.data.get('status', 'approved') == 'approved'
            && exists(/databases/$(database)/documents/pm_config/bootstrap)
          )
        );
      allow update: if pmIsAdmin()
        || (pmIsApproved() && request.auth.uid == userId
            && !(request.resource.data.diff(resource.data).affectedKeys().hasAny(['role','status'])));
      allow delete: if pmIsAdmin();
    }

    match /pm_pendingRoles/{email} {
      allow read, delete: if pmIsAdmin() || (request.auth != null && email == request.auth.token.email.lower());
      allow create, update: if pmIsAdmin();
    }

    // Bootstrap marker doc: managed by hand in the Console only.
    match /pm_config/{docId} {
      allow read, write: if false;
    }

    match /pm_auditLog/{id} {
      allow read: if pmIsAdmin();
      allow create: if pmIsApproved() && request.resource.data.changedBy == request.auth.uid;
      allow update, delete: if false;
    }

    match /pm_errorLog/{id} {
      allow read: if pmIsAdmin();
      allow create: if request.auth != null;
      allow update, delete: if false;
    }
    // ===== PM-SALE: end =====
